---
layout: layouts/base.njk
---
<article class="prose">
  <header class="post-header">
    <h1>{{ title }}</h1>
    {% if date %}<p class="meta"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></p>{% endif %}
  </header>
  {% if feature_image %}<img class="feature" src="{{ feature_image }}" alt="">{% endif %}
  {{ content | safe }}
</article>
