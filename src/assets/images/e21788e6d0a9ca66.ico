        <link rel="icon" type="image/svg+xml" href="/assets/img/logo_blue.svg" id="favicon_prefers_light">
        <link rel="icon" type="image/svg+xml" href="/assets/img/logo_white_orange.svg" id="favicon_prefers_dark">
        <script>
            let favicon_prefers_light = document.querySelector("link#favicon_prefers_light");
            let favicon_prefers_dark = document.querySelector("link#favicon_prefers_dark");

            let favicon_matcher = window.matchMedia("(prefers-color-scheme: dark)");

            function update_favicon() {
                if (favicon_matcher.matches) {
                    favicon_prefers_light.remove();
                    document.head.append(favicon_prefers_dark);
                } else {
                    document.head.append(favicon_prefers_light);
                    favicon_prefers_dark.remove();
                }
            }

            favicon_matcher.addListener(update_favicon);
            update_favicon();
        </script>

